# Server configuration
NODE_ENV=development
PORT=3000
API_TOKEN=<your-pre-shared-token>

# Namespace pattern (e.g., managed-{id} will create namespace "managed-abc123..." for id "abc123...")
NAMESPACE_PATTERN=managed-{id}

# Kubeconfig provider endpoint (optional - external service that provides user-scoped kubeconfigs)
# If not set, uses internal dummy endpoint with FALLBACK_KUBECONFIG
KUBECONFIG_PROVIDER_ENDPOINT=

# Fallback kubeconfig path (used when KUBECONFIG_PROVIDER_ENDPOINT is not set)
# This provides the shared_cluster mode behavior
FALLBACK_KUBECONFIG=<path-to-your-kubeconfig>
